<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>paper_checking_web</RootNamespace>
    <AssemblyName>paper_checking_web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF处理 - 替代IKVM+PDFBox -->
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="iText7" Version="9.0.0" />
    <PackageReference Include="iText7.bouncy-castle-adapter" Version="9.0.0" />
    
    <!-- Word文档处理 - 替代Spire.Doc -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="DocX" Version="3.0.1" />
    
    <!-- RTF生成 -->
    <PackageReference Include="RTF.Net" Version="1.0.0" />
    
    <!-- 硬件信息获取 (Linux兼容) -->
    <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" />
    
    <!-- Swagger API文档 -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    
    <!-- SignalR 实时通信 -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="2.0.0" />
    
    <!-- Entity Framework Core - 数据持久化 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0" />
  </ItemGroup>

</Project>
